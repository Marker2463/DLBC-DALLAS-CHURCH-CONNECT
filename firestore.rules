rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Authenticated users can read/write, and leader/pastor profiles can be read for scheduling
    match /users/{userId} {
      allow read: if request.auth != null || resource.data.role in ['leader', 'pastor'];
      allow create, update, delete: if request.auth != null;
    }
    
    // Consultations & Meeting Requests (including notes & journey timelines)
    match /consultations/{consultationId} {
      allow read: if true;
      allow write: if true;
      
      match /notes/{noteId} {
        allow read: if true;
        allow write: if true;
      }

      // All nested subcollections
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Direct Appointments
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Pastoral Consultation Notes (standalone collection fallback)
    match /consultation_notes/{noteId} {
      allow read, write: if true;
    }
    
    // Leader & Pastor Availability: Public read for booking slots, authenticated write
    match /availability/{leaderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}

