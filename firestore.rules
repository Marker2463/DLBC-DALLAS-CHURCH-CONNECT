rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function role() {
      return getUserData(request.auth.uid).role;
    }

    function isStaff() {
      return isAuthenticated() && role() in ['leader', 'pastor', 'admin'];
    }

    function isAdmin() {
      return isAuthenticated() && role() == 'admin';
    }

    function isLeaderStaff(leaderId) {
      return getUserData(leaderId).role in ['leader', 'pastor', 'admin'];
    }

    function meetingFieldsUnchanged() {
      return
        request.resource.data.get('meetUrl', null) == resource.data.get('meetUrl', null) &&
        request.resource.data.get('calendarEventId', null) == resource.data.get('calendarEventId', null) &&
        request.resource.data.get('meetingHostId', null) == resource.data.get('meetingHostId', null) &&
        request.resource.data.get('meetingHostEmail', null) == resource.data.get('meetingHostEmail', null);
    }

    // Private Google OAuth records must never be readable or writable by browser clients
    match /_privateGoogleOAuth/{uid} {
      allow read, write: if false;
    }

    match /googleOAuthStates/{stateId} {
      allow read, write: if false;
    }

    // Users collection: users cannot promote their own role
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      allow update: if (isAdmin()) || (
        isOwner(userId) && 
        request.resource.data.role == resource.data.role &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'leaderType', 'pendingRoleApproval', 'roleApprovedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Consultations collection
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.leaderId == request.auth.uid ||
        resource.data.pastorId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.memberId == request.auth.uid &&
        !request.resource.data.keys().hasAny([
          'meetUrl', 'calendarEventId', 'meetingHostId', 'meetingHostEmail'
        ]);

      allow update: if isAuthenticated() && meetingFieldsUnchanged() && (
        // Update by member
        (
          resource.data.memberId == request.auth.uid &&
          (resource.data.status in ['submitted', 'under_review', 'scheduled'])
        ) ||
        // Update by assigned leader or admin
        (
          resource.data.leaderId == request.auth.uid ||
          resource.data.pastorId == request.auth.uid ||
          isAdmin()
        )
      );

      allow delete: if isAdmin();

      // Subcollection: notes
      match /notes/{noteId} {
        allow read, create: if isAuthenticated() && (
          get(/databases/$(database)/documents/consultations/$(consultationId)).data.memberId == request.auth.uid ||
          get(/databases/$(database)/documents/consultations/$(consultationId)).data.leaderId == request.auth.uid ||
          get(/databases/$(database)/documents/consultations/$(consultationId)).data.pastorId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // Appointments collection (alias)
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.pastorId == request.auth.uid ||
        resource.data.leaderId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.memberId == request.auth.uid &&
        !request.resource.data.keys().hasAny([
          'meetUrl', 'calendarEventId', 'meetingHostId', 'meetingHostEmail'
        ]);

      allow update: if isAuthenticated() && meetingFieldsUnchanged() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.pastorId == request.auth.uid ||
        resource.data.leaderId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Availability collection
    match /availability/{leaderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == leaderId || isAdmin());
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }
  }
}
