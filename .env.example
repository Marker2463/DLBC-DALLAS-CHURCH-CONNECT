# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_WEB_URL: The URL where this applet is hosted.
# In AI Studio preview: https://ais-dev-2u7h72henqhoihyyqutb25-306127627821.us-east5.run.app
APP_URL="MY_APP_URL"
APP_WEB_URL="MY_APP_URL"

# Google Calendar OAuth 2.0 Credentials
# In Google Cloud Console, enable Google Calendar API and Google Meet REST API
GOOGLE_OAUTH_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_OAUTH_REDIRECT_URI="https://YOUR_API_DOMAIN/api/google/oauth/callback"

# Central Pastoral Office Fallback Credentials (used when individual leaders have not linked personal OAuth)
GOOGLE_OAUTH_REFRESH_TOKEN="your_central_office_refresh_token"
GOOGLE_MEET_ORGANIZER_EMAIL="pastoral-office@dlbc.org"

# 32-byte base64 encryption key to encrypt Google refresh tokens before storing in Firestore
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY="YOUR_BASE64_32_BYTE_KEY"

# Firestore database configuration
FIRESTORE_DATABASE_ID="ai-studio-dlbcchurchconnec-d51b846f-e39f-40ba-8929-2e22d9a82610"
APPOINTMENTS_COLLECTION="consultations"

# Firebase Admin Service Account (optional, if running outside default Google Cloud environment)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zoom Server-to-Server OAuth Credentials (optional alternative meeting method)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Feature flags
VITE_ENABLE_DEMO_LOGIN=false
